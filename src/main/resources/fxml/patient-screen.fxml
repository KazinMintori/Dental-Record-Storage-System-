<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.dentalclinic.controller.PatientController" styleClass="patient-screen-root">
    <Label fx:id="statusMessage" wrapText="true" styleClass="status-message status-bar"/>
    <StackPane VBox.vgrow="ALWAYS">
    <VBox fx:id="directoryView" styleClass="screen" spacing="22">
        <HBox alignment="CENTER_LEFT" spacing="10">
            <VBox spacing="4">
                <Label fx:id="directoryTitle" text="Bệnh nhân" styleClass="page-title"/>
                <Label fx:id="directorySubtitle" text="Quản lý thông tin và hồ sơ khám bệnh" styleClass="page-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="closeTrashButton" text="← Danh sách bệnh nhân" onAction="#closeTrash"
                    visible="false" managed="false" styleClass="secondary-button"/>
            <Button fx:id="viewTrashButton" text="Xem thùng rác" onAction="#openTrash" styleClass="secondary-button"/>
            <Button fx:id="bulkTrashButton" text="Thùng rác" onAction="#moveSelectedPatientsToTrash"
                    disable="true" styleClass="danger-button"/>
            <Button fx:id="addPatientButton" text="+ Thêm bệnh nhân" onAction="#openNewPatientForm" styleClass="primary-button"/>
        </HBox>
        <VBox fx:id="patientSearchPanel" spacing="9" styleClass="patient-search-panel">
            <HBox spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Tìm theo họ và tên..." onAction="#searchPatients"
                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                <Button text="Tìm" onAction="#searchPatients" styleClass="utility-button"/>
                <Button text="Bộ lọc" onAction="#toggleAdvancedFilters" styleClass="utility-button"/>
                <Button fx:id="clearAllFiltersButton" text="Xóa tất cả" onAction="#clearAllSearchFilters"
                        visible="false" managed="false" styleClass="clear-filter-button"/>
            </HBox>
            <VBox fx:id="advancedFilterPanel" spacing="9" visible="false" managed="false"
                  styleClass="advanced-filter-panel">
                <GridPane hgap="12" vgap="9">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <VBox spacing="4"><Label text="Mã bệnh nhân" styleClass="field-label"/><TextField fx:id="patientCodeFilterField" promptText="VD: BN-000123"/></VBox>
                    <VBox GridPane.columnIndex="1" spacing="4"><Label text="Số điện thoại" styleClass="field-label"/><TextField fx:id="phoneFilterField" promptText="Nhập SĐT"/></VBox>
                    <VBox GridPane.columnIndex="2" spacing="4"><Label text="Ngày sinh" styleClass="field-label"/><DatePicker fx:id="birthDateFilterField" promptText="Ngày/Tháng/Năm" maxWidth="Infinity"/></VBox>
                    <VBox GridPane.columnIndex="3" spacing="4"><Label text="Giới tính" styleClass="field-label"/><ComboBox fx:id="genderFilterField" promptText="Tất cả" maxWidth="Infinity"/></VBox>
                </GridPane>
            </VBox>
            <FlowPane fx:id="activeFiltersContainer" hgap="7" vgap="7" visible="false" managed="false"/>
        </VBox>
        <Label fx:id="listMessage" wrapText="true" styleClass="helper-text" visible="false" managed="false"/>
        <HBox fx:id="trashActions" alignment="CENTER_LEFT" spacing="10" visible="false" managed="false"
              styleClass="trash-actions">
            <Label fx:id="trashSelectedCountLabel" text="Đã chọn 0 hồ sơ" styleClass="trash-selection-count"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="bulkRestoreButton" text="Khôi phục đã chọn" onAction="#restoreSelectedPatients"
                    styleClass="restore-button"/>
            <Button fx:id="bulkPermanentDeleteButton" text="Xóa vĩnh viễn đã chọn"
                    onAction="#permanentlyDeleteSelectedPatients" styleClass="danger-button"/>
        </HBox>
        <StackPane VBox.vgrow="ALWAYS">
            <TableView fx:id="patientTable" VBox.vgrow="ALWAYS" styleClass="patient-table">
                <columns>
                    <TableColumn fx:id="patientSelectColumn" prefWidth="46" minWidth="46" maxWidth="46" sortable="false"/>
                    <TableColumn fx:id="patientCodeColumn" text="Mã" prefWidth="125" minWidth="125" maxWidth="125" sortable="false"/>
                    <TableColumn fx:id="patientNameColumn" text="Tên" prefWidth="430" minWidth="220" sortable="false"/>
                    <TableColumn fx:id="patientBirthDateColumn" text="Ngày sinh" prefWidth="135" minWidth="135" maxWidth="135" sortable="false"/>
                    <TableColumn fx:id="patientPhoneColumn" text="SĐT" prefWidth="165" minWidth="165" maxWidth="165" sortable="false"/>
                    <TableColumn fx:id="patientActionColumn" text="Hành động" prefWidth="150" minWidth="150" maxWidth="235"
                                 sortable="false" styleClass="last-patient-column"/>
                </columns>
                <placeholder>
                    <Label fx:id="patientTablePlaceholder" text="Chưa có bệnh nhân" styleClass="table-empty-message"/>
                </placeholder>
            </TableView>
            <VBox fx:id="tableLoadingOverlay" alignment="CENTER" spacing="9" visible="false" managed="false"
                  styleClass="table-loading-overlay">
                <ProgressIndicator prefWidth="40" prefHeight="40"/>
                <Label fx:id="tableLoadingLabel" text="Đang tải dữ liệu..." styleClass="helper-text"/>
            </VBox>
        </StackPane>
        <HBox alignment="CENTER_LEFT" spacing="8" styleClass="pagination-bar">
            <Label fx:id="paginationStatusLabel" text="Hiển thị 0 - 0 trên tổng số 0 bệnh nhân" styleClass="pagination-status"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="firstPageButton" text="|&lt; Đầu" onAction="#goToFirstPage" styleClass="pagination-button"/>
            <Button fx:id="previousPageButton" text="&lt; Trước" onAction="#goToPreviousPage" styleClass="pagination-button"/>
            <Label fx:id="pageNumberLabel" text="Trang 1 / 1" styleClass="page-number"/>
            <Button fx:id="nextPageButton" text="Sau &gt;" onAction="#goToNextPage" styleClass="pagination-button"/>
            <Button fx:id="lastPageButton" text="Cuối &gt;|" onAction="#goToLastPage" styleClass="pagination-button"/>
        </HBox>
    </VBox>

    <VBox fx:id="patientLoadingView" alignment="CENTER" spacing="14" visible="false" managed="false"
          styleClass="screen patient-loading-view">
        <ProgressIndicator prefWidth="54" prefHeight="54"/>
        <Label text="Đang tải hồ sơ bệnh nhân..." styleClass="section-title"/>
        <Label fx:id="patientLoadingName" styleClass="page-subtitle"/>
        <Label text="Đang đồng bộ thông tin và lịch sử khám từ Supabase" styleClass="helper-text"/>
    </VBox>

    <VBox fx:id="detailView" styleClass="screen" spacing="18" visible="false" managed="false">
        <Button text="← Danh sách bệnh nhân" onAction="#showDirectory"
                styleClass="back-button" maxWidth="190"/>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label fx:id="selectedPatientName" styleClass="page-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="editPatientButton" text="Chỉnh sửa thông tin"
                    onAction="#openEditPatientForm" styleClass="secondary-button"/>
            <Button fx:id="deletePatientButton" text="Xóa hồ sơ"
                    onAction="#moveSelectedPatientToTrash" styleClass="danger-button"/>
            <Button fx:id="addVisitButton" text="+ Thêm lần khám"
                    onAction="#openVisitForm" styleClass="primary-button"/>
        </HBox>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS" styleClass="transparent-scroll">
            <VBox spacing="18">
                <VBox styleClass="panel" spacing="16">
                    <Label text="Thông tin bệnh nhân" styleClass="section-title"/>
                    <Separator/>
                    <GridPane hgap="28" vgap="16">
                        <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                        <VBox spacing="4"><Label text="Họ và tên" styleClass="field-label"/><Label fx:id="patientNameValue" styleClass="field-value"/></VBox>
                        <VBox GridPane.columnIndex="1" spacing="4"><Label text="Giới tính" styleClass="field-label"/><Label fx:id="patientGenderValue" styleClass="field-value"/></VBox>
                        <VBox GridPane.rowIndex="1" spacing="4"><Label text="Ngày sinh" styleClass="field-label"/><Label fx:id="patientBirthDateValue" styleClass="field-value"/></VBox>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="4"><Label text="Số điện thoại" styleClass="field-label"/><Label fx:id="patientPhoneValue" styleClass="field-value"/></VBox>
                        <VBox GridPane.rowIndex="2" spacing="4"><Label text="Giấy tờ tùy thân (không bắt buộc)" styleClass="field-label"/><Label fx:id="patientIdentityValue" styleClass="field-value"/></VBox>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" spacing="4"><Label text="Số thẻ BHYT (không bắt buộc)" styleClass="field-label"/><Label fx:id="patientInsuranceValue" styleClass="field-value"/></VBox>
                        <VBox GridPane.rowIndex="3" spacing="4"><Label text="Địa chỉ (không bắt buộc)" styleClass="field-label"/><Label fx:id="patientAddressValue" styleClass="field-value" wrapText="true"/></VBox>
                        <VBox GridPane.columnIndex="1" GridPane.rowIndex="3" spacing="4"><Label text="Nghề nghiệp (không bắt buộc)" styleClass="field-label"/><Label fx:id="patientOccupationValue" styleClass="field-value"/></VBox>
                        <VBox GridPane.rowIndex="4" spacing="4"><Label text="Dân tộc (không bắt buộc)" styleClass="field-label"/><Label fx:id="patientEthnicityValue" styleClass="field-value"/></VBox>
                    </GridPane>
                </VBox>

                <TitledPane fx:id="visitFormPane" text="Thông tin lần khám" expanded="false" animated="false" styleClass="form-pane">
                    <VBox spacing="14" styleClass="form-grid">
                        <HBox alignment="CENTER_LEFT">
                            <Label fx:id="visitFormHeading" text="Thêm lần khám" styleClass="section-title"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button fx:id="deleteVisitButton" text="Xóa lần khám" onAction="#deleteCurrentVisit"
                                    visible="false" managed="false" styleClass="danger-button"/>
                        </HBox>
                        <GridPane hgap="14" vgap="12">
                            <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                            <VBox spacing="5"><Label text="Ngày khám *" styleClass="field-label"/><DatePicker fx:id="visitDateField" promptText="Ngày/Tháng/Năm" maxWidth="Infinity"/><Label fx:id="visitDateError" visible="false" managed="false" wrapText="true" styleClass="field-error"/></VBox>
                            <VBox GridPane.columnIndex="1" spacing="5"><Label text="Bác sĩ khám *" styleClass="field-label"/><TextField fx:id="dentistField"/><Label fx:id="dentistError" visible="false" managed="false" wrapText="true" styleClass="field-error"/></VBox>
                            <VBox GridPane.rowIndex="1" spacing="5"><Label text="Triệu chứng *" styleClass="field-label"/><TextArea fx:id="symptomsField" prefRowCount="2" wrapText="true"/><Label fx:id="symptomsError" visible="false" managed="false" wrapText="true" styleClass="field-error"/></VBox>
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="5"><Label text="Chẩn đoán *" styleClass="field-label"/><TextArea fx:id="diagnosisField" prefRowCount="2" wrapText="true"/><Label fx:id="diagnosisError" visible="false" managed="false" wrapText="true" styleClass="field-error"/></VBox>
                            <VBox GridPane.rowIndex="2" spacing="5"><Label text="Phương pháp điều trị *" styleClass="field-label"/><TextArea fx:id="treatmentField" prefRowCount="2" wrapText="true"/><Label fx:id="treatmentError" visible="false" managed="false" wrapText="true" styleClass="field-error"/></VBox>
                            <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" spacing="5"><Label text="Ghi chú" styleClass="field-label"/><TextArea fx:id="visitNoteField" prefRowCount="2" wrapText="true"/></VBox>
                        </GridPane>
                        <Separator/>
                        <HBox alignment="CENTER_LEFT">
                            <VBox spacing="3">
                                <Label text="Doanh thu" styleClass="section-title"/>
                                <Label text="Diễn giải tự lấy từ Triệu chứng — có thể xóa hoặc chỉnh sửa độc lập"
                                       styleClass="helper-text"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="+ Thêm dòng doanh thu" onAction="#addRevenueRow" styleClass="secondary-button"/>
                        </HBox>
                        <HBox spacing="8" styleClass="revenue-header">
                            <Label text="Số hiệu (tùy chọn)" prefWidth="120"/><Label text="Ngày tháng" prefWidth="145"/>
                            <Label text="Diễn giải (tùy chọn)" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Label text="Số tiền" prefWidth="135"/><Label text="" prefWidth="48"/>
                        </HBox>
                        <VBox fx:id="revenueRowsContainer" spacing="8"/>
                        <Label fx:id="visitRevenueError" visible="false" managed="false" wrapText="true" styleClass="field-error"/>
                        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="revenue-total">
                            <Label text="Tổng cộng" styleClass="field-label"/>
                            <Label fx:id="revenueTotalLabel" text="0 đ" styleClass="revenue-total-value"/>
                        </HBox>
                        <HBox alignment="CENTER_RIGHT" spacing="8">
                            <Button text="Hủy" onAction="#cancelVisitForm" styleClass="secondary-button"/>
                            <Button text="Lưu lần khám" onAction="#saveVisit" styleClass="primary-button"/>
                        </HBox>
                    </VBox>
                </TitledPane>

                <VBox styleClass="panel" spacing="14">
                    <HBox alignment="CENTER_LEFT"><Label text="Lịch sử khám" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="visitCountLabel" text="0 lần khám" styleClass="count-badge"/></HBox>
                    <VBox fx:id="visitListContainer" spacing="12"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </VBox>

    <VBox fx:id="patientFormView" styleClass="screen" spacing="18" visible="false" managed="false">
        <Button text="← Quay lại" onAction="#cancelPatientForm" styleClass="back-button" maxWidth="150"/>
        <TitledPane fx:id="patientFormPane" text="Thông tin bệnh nhân" expanded="true" collapsible="false"
                    animated="false" styleClass="form-pane">
            <VBox spacing="16" styleClass="form-grid">
                <Label fx:id="patientFormTitle" text="Thông tin bệnh nhân" styleClass="page-title"/>
                <GridPane hgap="14" vgap="12">
                    <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                    <VBox spacing="5"><Label text="Họ và tên *" styleClass="field-label"/><TextField fx:id="patientNameField" promptText="Nhập họ và tên"/></VBox>
                    <VBox GridPane.columnIndex="1" spacing="5"><Label text="Giới tính *" styleClass="field-label"/><ComboBox fx:id="patientGenderField" promptText="Chọn Nam, Nữ hoặc Khác" maxWidth="Infinity"/></VBox>
                    <VBox GridPane.rowIndex="1" spacing="5"><Label text="Ngày sinh *" styleClass="field-label"/><DatePicker fx:id="patientBirthDateField" promptText="Ngày/Tháng/Năm" maxWidth="Infinity"/></VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="1" spacing="5"><Label text="Số điện thoại" styleClass="field-label"/><TextField fx:id="patientPhoneField" promptText="Nhập số điện thoại"/></VBox>
                    <VBox GridPane.rowIndex="2" spacing="5"><Label text="Giấy tờ tùy thân" styleClass="field-label"/><TextField fx:id="patientIdentityField"/></VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="2" spacing="5"><Label text="Số thẻ BHYT" styleClass="field-label"/><TextField fx:id="patientInsuranceField"/></VBox>
                    <VBox GridPane.rowIndex="3" spacing="5"><Label text="Địa chỉ" styleClass="field-label"/><TextField fx:id="patientAddressField"/></VBox>
                    <VBox GridPane.columnIndex="1" GridPane.rowIndex="3" spacing="5"><Label text="Nghề nghiệp" styleClass="field-label"/><TextField fx:id="patientOccupationField"/></VBox>
                    <VBox GridPane.rowIndex="4" spacing="5"><Label text="Dân tộc" styleClass="field-label"/><TextField fx:id="patientEthnicityField"/></VBox>
                </GridPane>
                <HBox alignment="CENTER_RIGHT" spacing="8">
                    <Button text="Hủy" onAction="#cancelPatientForm" styleClass="secondary-button"/>
                    <Button text="Lưu" onAction="#savePatient" styleClass="primary-button"/>
                </HBox>
            </VBox>
        </TitledPane>
    </VBox>
    </StackPane>
</VBox>
